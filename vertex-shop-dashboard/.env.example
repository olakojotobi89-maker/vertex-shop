# Vertex Shop Admin Dashboard - environment configuration
# Copy this file to `.env` and fill in your real values.
# NEVER commit the real `.env` file. It is ignored by `.gitignore`.
#
# SECURITY:
#   - Use only the SUPABASE_ANON_KEY (publishable key) in the public web app.
#   - The SUPABASE_SERVICE_ROLE_KEY grants full access and MUST be kept only
#     on trusted servers. Do NOT put it in the public web app or commit it.

# Supabase project URL (e.g. https://xxxx.supabase.co)
SUPABASE_URL=

# Supabase publishable / anon key (safe for the public web app)
SUPABASE_ANON_KEY=

# Supabase service-role key (SECRET - server/admin only, never public).
# The Python desktop dashboard does not require this for normal use when
# RLS admin policies are enabled and an admin user is signed in.
SUPABASE_SERVICE_ROLE_KEY=

